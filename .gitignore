# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TTS assets — generated by scripts/prepare-tts.mjs (not committed, ~20MB)
public/tts/espeak-ng-data/
public/tts/dist/
public/tts/piper-phonemize-wasm.*
# Piper model.onnx binaries (61MB) are fetched from HuggingFace at runtime
# (see VITE_TTS_MODEL_BASE). The small model.onnx.json configs (carrying
# phoneme_id_map) and speakers.json are committed — the HF export ships an
# empty phoneme_id_map, which would silence all audio.
public/tts/models/*/*
!public/tts/models/*/model.onnx.json

# Old piper directory (superseded by public/tts/)
public/piper/
public/tts/piper-phonemize.wasm

# OMC (oh-my-claudecode) tooling state
.omc/

# Chat exports (generated by the app)
chat-*.csv
